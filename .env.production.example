# Copy to .env on the server and replace every example value.
STOCKHOLM_DOMAIN=stockholm.example.com
HELSINKI_DOMAIN=helsinki.example.com
DASHBOARD_DOMAIN=triage.example.com
DASHBOARD_USER=reviewer
# Generate with: docker run --rm caddy:2 caddy hash-password --plaintext 'your-long-random-password'
DASHBOARD_PASSWORD_HASH=replace-with-caddy-password-hash

TELEMETRY_PASSWORD=replace-with-64-hex-characters
AGENT_DB_PASSWORD=replace-with-64-hex-characters
TELEMETRY_WRITER_PASSWORD=replace-with-64-hex-characters
USERDB_ADMIN_PASSWORD=replace-with-64-hex-characters
APP_DB_PASSWORD=replace-with-64-hex-characters
